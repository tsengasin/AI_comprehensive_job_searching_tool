# Copy this file to .env and fill in your own values.
# .env is git-ignored. Never commit it, never paste these values into an AI chat,
# a GitHub issue or a screenshot.

# Jooble: free key from https://jooble.org/api/about
JOOBLE_APP_KEY=

# SerpApi (Google Jobs): free plan key from https://serpapi.com/manage-api-key
SERPAPI_KEY=

# Telegram: create a bot with @BotFather, then see docs/02-api-keys.md for the chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
