<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS daily schedule. Replace REPLACE_WITH_REPO_PATH with the full path of this repo
  (run `pwd` inside it), then follow docs/03-scheduling.md.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jobsearch.daily</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>REPLACE_WITH_REPO_PATH/scripts/run_daily.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>8</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/tmp/jobsearch-launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/jobsearch-launchd.log</string>
</dict>
</plist>
